# ─────────────────────────────────────────────────────────────
# Client environment variables
# Copy to .env for local development.
# ─────────────────────────────────────────────────────────────

# ── NEXT_PUBLIC_API_URL ───────────────────────────────────────
# Baked into the JavaScript bundle at BUILD TIME.
# Must be a URL the USER'S BROWSER can reach.
# → Never use a Docker internal hostname here (e.g. "server").
# Local dev  → http://localhost:8000/api
# Production → https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ── API_URL ───────────────────────────────────────────────────
# Used ONLY by Next.js Server Components / SSR at RUNTIME.
# Never reaches the browser.
# Local dev  → http://localhost:8000/api  (same as above)
# Docker     → overridden by docker-compose to http://server:8000/api
#              so SSR calls stay inside the container network
API_URL=http://localhost:8000/api
